{
    // workbranch
    "workbench.colorTheme": "Material Theme Palenight High Contrast",
    "workbench.layoutControl.enabled": false,
    "workbench.list.smoothScrolling": true,
    "workbench.startupEditor": "newUntitledFile",
    "workbench.tree.expandMode": "singleClick",
    "workbench.editor.tabSizing": "shrink",
    "workbench.panel.defaultLocation": "right",
    "workbench.tree.enableStickyScroll": false,
    "workbench.sideBar.location": "right",
    "workbench.editor.enablePreview": false,
    "workbench.editor.showTabs": "none",
    "workbench.tree.indent": 15,
    "markdown.preview.fontFamily": "Dank Mono",
    // explore
    "explorer.compactFolders": false,
    "explorer.sortOrder": "type",
    // Editor
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "keyword",
                    "variable.language",
                    "entity.other.attribute-name.html",
                    "entity.other.attribute-name",
                    "keyword.control",
                    "storage.type",
                    "comment",
                    "comment.block",
                    "comment.line"
                ],
                "settings": {
                    "fontStyle": ""
                }
            }
        ]
    },
    "editor.copyWithSyntaxHighlighting": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.emptySelectionClipboard": false,
    "editor.linkedEditing": true,
    // "editor.fontLigatures": false,
    "diffEditor.wordWrap": "on",
    "notebook.output.wordWrap": true,
    "editor.wordWrap": "wordWrapColumn",
    "window.newWindowDimensions": "inherit",
    "window.nativeFullScreen": true,
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "files.insertFinalNewline": true,
    "editor.multiCursorModifier": "ctrlCmd",
    "diffEditor.renderSideBySide": false,
    "editor.snippetSuggestions": "top",
    "editor.detectIndentation": false,
    "editor.lineNumbers": "off",
    "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
    "editor.minimap.maxColumn": 250,
    "editor.accessibilitySupport": "off",
    "editor.padding.top": 16,
    "workbench.statusBar.visible": false,
    "editor.stickyScroll.enabled": false,
    "editor.guides.indentation": false,
    "editor.inlineSuggest.fontFamily": "Dank Mono",
    "window.zoomLevel": 1,
    "editor.cursorWidth": 7,
    "editor.cursorBlinking": "expand",
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "always"
    },
    "editor.lineHeight": 38,
    "explorer.autoReveal": true,
    "editor.formatOnSave": true,
    "editor.minimap.enabled": false,
    "editor.guides.bracketPairs": "active",
    "window.commandCenter": false,
    "files.autoSave": "off",
    "security.workspace.trust.untrustedFiles": "newWindow",
    "debug.toolBarLocation": "docked",
    "editor.autoIndent": "none",
    "editor.wordWrapColumn": 120,
    "editor.quickSuggestions": {
        "strings": true
    },
    // Typography
    "editor.suggestFontSize": 16,
    "editor.suggestLineHeight": 30,
    "terminal.integrated.lineHeight": 1.5,
    "editor.fontSize": 18,
    "editor.fontWeight": "bold",
    "editor.fontFamily": "'Dank Mono', Menlo, Monaco, 'Courier New', monospace",
    "terminal.integrated.fontSize": 16,
    "search.useIgnoreFiles": false,
    // terminal
    "terminal.integrated.fontFamily": "MesloLGS NF",
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "editor.inlineSuggest.suppressSuggestions": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "block",
    "terminal.integrated.fontWeight": "700",
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.cursorWidth": 4,
    "scm.diffDecorationsGutterWidth": 2,
    // git
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "gitlens.blame.fontFamily": "Dank Mono",
    "git.untrackedChanges": "separate",
    // Extension configs
    "emmet.includeLanguages": {
        "vue-html": "html",
        "vue": "html",
        "react": "html",
        "javascript": "html"
    },
    "emmet.showSuggestionsAsSnippets": true,
    "emmet.triggerExpansionOnTab": true,
    "cSpell.allowCompoundWords": true,
    "cSpell.language": "en,en-US",
    "diffEditor.hideUnchangedRegions.enabled": true,
    "window.customTitleBarVisibility": "auto",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "workbench.iconTheme": "material-icon-theme",
    "typescript.updateImportsOnFileMove.enabled": "never",
    "terminal.integrated.enableVisualBell": false,
    "security.promptForLocalFileProtocolHandling": false,
    "cody.autocomplete.enabled": true,
    "editor.cursorSurroundingLines": 8,
    "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
    "files.exclude": {
        "node_modules": true,
        "docs": true,
        "out": true,
        "public": true,
        "postcss.config.mjs": true,
        "tsconfig.json": true,
        "components.json": true,
        "tsconfig.tsbuildinfo": true,
        "next-env.d.ts": true,
        "next.config.mjs": true,
        "env.mjs": true,
        "package-lock.json": true,
        "package.json": true,
        "commitlint.config.js": true,
        ".husky": true,
        ".prettierrc": true,
        ".prettierignore": true,
        ".huskyrc": true,
        ".lintstagedrc": true,
        ".lintstagedrc.json": true,
        ".eslintrc.js": true,
        ".eslintignore": true,
        ".gitignore": true,
        ".nvmrc": true,
        ".next": true,
        ".vscode": true,
        ".storybook": true
    },
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    /**
   * Prettier
   **/
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[tailwindcss]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[vue]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "prettier.requireConfig": true,
    "prettier.useEditorConfig": false,
    "prettier.tabWidth": 4,
    "[html]": {
        "editor.defaultFormatter": "apility.beautify-blade",
        "editor.formatOnSave": true
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "codesnap.containerPadding": "8em",
    "codesnap.boxShadow": "rgba(0, 0, 0, 0.55) 0px 12px 24px",
    "explorer.confirmDelete": false,
    "chat.editor.wordWrap": "on",
    "tailwindCSS.includeLanguages": {
        "plaintext": "html"
    },
    "tailwindCSS.experimental.configFile": null,
    "workbench.activityBar.location": "hidden",
    "codesnap.backgroundColor": "#FFC540",
    "codesnap.showLineNumbers": false,
    "codesnap.roundedCorners": true,
    "vscode_custom_css.imports": [
        "file:////Users/alirezaakbarzadeh/workshop/custome-vscode.css",
        "file:///Users/alirezaakbarzadeh/workshop/vscode-script.js"
    ],
}
